singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions='--nv'

singularity.cacheDir = '/scratch/tovar_root/tovar0/tovar/singularity-cache'

process {
    executor='slurm'
    containerOptions='--bind "/scratch:/scratch" --bind "/nfs:/nfs" --bind "/gpfs:/gpfs"'
    shell = ['/bin/bash', '-ueo', 'pipefail']
    clusterOptions='--account=tovar0'
	}

trace.enabled = true
report.enabled = true
dag.enabled = true
nextflowVersion = '>=19.04.1'

//
// Below are the key file names you'll need to change
//

params.blacklist = ['rn7': ['/nfs/turbo/umms-tovar/refs/annot/rn7/rn7_liftOver_mm10-blacklist.v2.bed.gz']]
params.chrom_sizes = ['rn7': '/nfs/turbo/umms-tovar/refs/annot/rn7/rn7.chrom.sizes']
params.bwa_index = ['rn7': '/nfs/turbo/umms-tovar/refs/bwa/rn7/rn7.fa']
params.tss = ['rn7':'/nfs/turbo/umms-tovar/refs/annot/rn7/rn7.tss.refseq.bed']
params.plot_signal_at_genes = ['Gapdh']
