singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions='--nv'

singularity.cacheDir = '/scratch/?_root/account/uniqname/singularity-cache'

process {
    executor='slurm'
    containerOptions='--bind "/scratch:/scratch" --bind "/nfs:/nfs" --bind "/gpfs:/gpfs"'
    shell = ['/bin/bash', '-ueo', 'pipefail']
    clusterOptions='--account=account'
	}

trace.enabled = true
report.enabled = true
dag.enabled = true
nextflowVersion = '>=19.04.1'

//
// Below are the key file names you'll need to change
//

params.blacklist = ['hg38': ['/path/to/annot/hg38/hg38.blacklist.bed.gz']]
params.chrom_sizes = ['hg38': '/path/to/annot/hg38/hg38.chrom-sizes']
params.bwa_index = ['hg38': '/path/to/bwa/hg38.fa']
params.tss = ['hg38':'/path/to/annot/hg38/hg38.tss.refseq.bed']
params.plot_signal_at_genes = ['GAPDH']
